{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": ["scripts/**/*.ts", "skills/*/scripts/**/*.ts", "skills/*/assets/scripts/**/*.ts", "inprogress-skills/*/scripts/**/*.ts", "inprogress-skills/*/assets/scripts/**/*.ts"]
}
