{
	"$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
	"files": {
		"includes": ["scripts/**/*.ts", "skills/*/scripts/**/*.ts", "skills/*/assets/scripts/**/*.ts", "inprogress-skills/*/scripts/**/*.ts", "inprogress-skills/*/assets/scripts/**/*.ts"]
	},
	"formatter": { "enabled": false },
	"assist": { "enabled": false },
	"linter": {
		"rules": { "preset": "none", "suspicious": { "noExplicitAny": "error" } }
	}
}
